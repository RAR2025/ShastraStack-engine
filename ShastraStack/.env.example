PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://shastra:change_me_local_only@localhost:5432/shastrastack
TEST_DATABASE_URL=postgres://shastra:change_me_local_only@localhost:5432/shastrastack_test
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
MOCK_API_URL=http://localhost:5000
APP_BACKEND_URL=http://localhost:3000
# Async audit transport: amqplib -> durable queue -> log consumer worker -> PG.
# sync = direct PostgreSQL inserts (used by tests); async = RabbitMQ + PG outbox fallback.
RABBITMQ_URL=amqp://shastra:change_me_local_only@localhost:5672
RABBITMQ_LOG_QUEUE=shastrastack.logs
RABBITMQ_LOG_EXCHANGE=shastrastack.logs
RABBITMQ_PREFETCH=10
LOG_TRANSPORT=async
