PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:4000,http://localhost:3000
# Local dev token guarding /api/admin/* (never exposed in responses)
ADMIN_TOKEN=local-dev-token
# ShastraStack engine base URL used ONLY when a judge explicitly enables notification
ENGINE_BASE_URL=http://localhost:4000
