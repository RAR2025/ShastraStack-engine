# ---- Root / shared (copy values into each service .env as needed) ----
POSTGRES_USER=shastra
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=shastrastack
POSTGRES_PORT=5432
DATABASE_URL=postgres://shastra:change_me_local_only@localhost:5432/shastrastack

# ---- Ports ----
APP_BACKEND_PORT=3000
APP_FRONTEND_PORT=5173
SHASTRASTACK_PORT=4000
MOCK_BACKEND_PORT=5000
MOCK_FRONTEND_PORT=5174

# ---- Service URLs (each service reads its own copy) ----
APP_BACKEND_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:5173
SHASTRASTACK_URL=http://localhost:4000
MOCK_API_URL=http://localhost:5000
MOCK_FRONTEND_URL=http://localhost:5174

# ---- Misc ----
NODE_ENV=development
LOG_LEVEL=info

# ---- RabbitMQ async audit logging (ShastraStack) ----
RABBITMQ_URL=amqp://shastra:change_me_local_only@localhost:5672
RABBITMQ_USER=shastra
RABBITMQ_PASSWORD=change_me_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_LOG_QUEUE=shastrastack.logs
RABBITMQ_LOG_EXCHANGE=shastrastack.logs
RABBITMQ_PREFETCH=10
# sync = direct PostgreSQL inserts (tests); async = RabbitMQ + PG outbox fallback
LOG_TRANSPORT=async
